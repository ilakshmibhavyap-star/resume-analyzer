# Copy this file to ".env" and put your real Gemini API key here.
# NEVER commit the real .env file to GitHub.

GEMINI_API_KEY=your-key-goes-here

# Gemini generation model.
# Gemini 3.6 Flash currently has a Free Tier.
GEN_MODEL=gemini-3.6-flash

# Gemini embedding model.
EMBED_MODEL=gemini-embedding-001

# Embedding dimensions.
EMBED_DIM=768

# RAG settings.
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=6

# Gemini retry settings.
MAX_RETRIES=3
RETRY_BASE_SECONDS=1.5

# Resume limits.
MAX_PAGES=15
MAX_CONTEXT_CHUNKS=6
